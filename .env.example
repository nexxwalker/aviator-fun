# Application Configuration
APP_ENV=development
PORT=3000

# PostgreSQL Database Configuration
BLUEPRINT_DB_HOST=localhost
BLUEPRINT_DB_PORT=5432
BLUEPRINT_DB_DATABASE=crashdb
BLUEPRINT_DB_USERNAME=postgres
BLUEPRINT_DB_PASSWORD=postgres
BLUEPRINT_DB_SCHEMA=public

# Redis Configuration
# Production: use the managed Redis connection URL provided by Vercel.
REDIS_URL=rediss://default:<password>@<managed-redis-host>:6380/0
REDIS_PASSWORD=
REDIS_DB=0

# Local development example:
# REDIS_URL=localhost:6379

# Game Configuration (Optional - defaults are set in code)
# TICK_INTERVAL=100ms
# BETTING_TIME=5s
# MIN_BET_AMOUNT=1.0
# MAX_BET_AMOUNT=10000.0
# HOUSE_EDGE=0.01

# Security (Production)
# JWT_SECRET=your-secret-key-here
# CORS_ORIGINS=https://yourdomain.com

# Monitoring (Optional)
# SENTRY_DSN=
# LOG_LEVEL=info
